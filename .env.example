# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite o .env.local no repositório.
#
# ATENÇÃO: variáveis com prefixo EXPO_PUBLIC_ são embutidas no bundle
# e ficam visíveis para qualquer pessoa que inspecione o app.
# Para tokens sensíveis em produção, use um proxy/backend intermediário.

# URL base do Strapi (sem barra final)
# Desenvolvimento local: http://localhost:1337
# Produção: https://seu-dominio.com
EXPO_PUBLIC_STRAPI_URL=http://localhost:1337

# Token de acesso à API do Strapi
EXPO_PUBLIC_STRAPI_TOKEN=
