#!/bin/bash

# Pre-commit hook para verificar se documentação foi atualizada
# Este script roda automaticamente antes de cada commit

# Cores para output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo ""
echo "${BLUE}🔍 Executando verificações de pre-commit...${NC}"
echo ""

# 1. Verificar se há mudanças no design-system
echo "${BLUE}📋 [1/3] Verificando documentação do Design System...${NC}"

DESIGN_SYSTEM_CHANGED=$(git diff --cached --name-only | grep -c "src/design-system/\(components\|tokens\|theme\)/")
DOCS_CHANGED=$(git diff --cached --name-only | grep -c "DESIGN_SYSTEM_SUMMARY.md")

if [ "$DESIGN_SYSTEM_CHANGED" -gt 0 ] && [ "$DOCS_CHANGED" -eq 0 ]; then
    echo ""
    echo "${RED}❌ ERRO: Mudanças detectadas no Design System sem atualização da documentação!${NC}"
    echo ""
    echo "${YELLOW}📝 Arquivos modificados no Design System:${NC}"
    git diff --cached --name-only | grep "src/design-system/\(components\|tokens\|theme\)/" | sed 's/^/  - /'
    echo ""
    echo "${YELLOW}⚠️  AÇÃO NECESSÁRIA:${NC}"
    echo "  1. Atualize: ${GREEN}src/design-system/DESIGN_SYSTEM_SUMMARY.md${NC}"
    echo "  2. git add src/design-system/DESIGN_SYSTEM_SUMMARY.md"
    echo "  3. Tente o commit novamente"
    echo ""
    exit 1
fi

if [ "$DESIGN_SYSTEM_CHANGED" -gt 0 ] && [ "$DOCS_CHANGED" -gt 0 ]; then
    echo "${GREEN}✅ Design System e documentação atualizados!${NC}"
else
    echo "${GREEN}✅ Nenhuma mudança no Design System${NC}"
fi

# 2. Verificar ESLint
echo ""
echo "${BLUE}🔍 [2/3] Verificando ESLint...${NC}"

# Pegar apenas arquivos .ts, .tsx, .js, .jsx que foram modificados
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$')

if [ -n "$STAGED_FILES" ]; then
    echo "${YELLOW}Arquivos a serem verificados:${NC}"
    echo "$STAGED_FILES" | sed 's/^/  - /'
    echo ""
    
    # Executar ESLint apenas nos arquivos modificados
    if ! yarn lint --max-warnings=0 $STAGED_FILES; then
        echo ""
        echo "${RED}❌ ERRO: Problemas de linting encontrados!${NC}"
        echo ""
        echo "${YELLOW}⚠️  AÇÃO NECESSÁRIA:${NC}"
        echo "  1. Corrija os erros acima"
        echo "  2. Ou execute: ${GREEN}yarn lint:fix${NC} para correção automática"
        echo "  3. git add <arquivos-corrigidos>"
        echo "  4. Tente o commit novamente"
        echo ""
        exit 1
    fi
    echo "${GREEN}✅ Linting passou!${NC}"
else
    echo "${GREEN}✅ Nenhum arquivo JS/TS para verificar${NC}"
fi

# 3. Verificar TypeScript
echo ""
echo "${BLUE}🔍 [3/3] Verificando tipos TypeScript...${NC}"

if ! yarn type-check; then
    echo ""
    echo "${RED}❌ ERRO: Erros de tipo TypeScript encontrados!${NC}"
    echo ""
    echo "${YELLOW}⚠️  AÇÃO NECESSÁRIA:${NC}"
    echo "  1. Corrija os erros de tipo acima"
    echo "  2. Verifique com: ${GREEN}yarn type-check${NC}"
    echo "  3. Tente o commit novamente"
    echo ""
    exit 1
fi

echo "${GREEN}✅ Verificação de tipos passou!${NC}"

# Tudo passou!
echo ""
echo "${GREEN}╔════════════════════════════════════════╗${NC}"
echo "${GREEN}║  ✅ Todas as verificações passaram!   ║${NC}"
echo "${GREEN}╚════════════════════════════════════════╝${NC}"
echo ""
exit 0

