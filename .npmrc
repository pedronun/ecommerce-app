; Configurações do NPM para o projeto E-commerce App

; Define o registry do NPM (padrão)
registry=https://registry.npmjs.org/

; Configurações de segurança
audit-level=moderate
fund=false

; Salvar versões exatas (sem ^ ou ~)
save-exact=false

; Usar lock file
package-lock=true

; Configurações de instalação
prefer-offline=false
progress=true

; Engine strict - garante versão correta do Node
engine-strict=true

